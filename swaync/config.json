{
  "positionX": "right",
  "positionY": "top",
  "control-center-width": 400,
  "widgets": [
    "buttons-grid",
    "mpris",
    "dnd",
    "notifications"
  ],
  "widget_config": {
    "buttons-grid": {
      "actions": [
        {
          "label": "󰖩",
          "command": "~/.config/swaync/open-app.py network"
        },
        {
          "label": "󰂯",
          "command": "~/.config/swaync/open-app.py bluetooth"
        },
        {
          "label": "󰒓",
          "command": "~/.config/swaync/open-app.py settings"
        },
        {
          "label": "󰀻",
          "command": "qs -p ~/.config/quickshell/shell.qml"
        }
      ]
    },
    "mpris": {
      "player": "spotify",
      "show-cover-art": true,
      "show-progress": true
    }
  }
}
