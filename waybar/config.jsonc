{
    // Position TOP
    "layer": "top",
    "margin-top": 14,
    "margin-bottom": -10,

    "height" : 16,
    "spacing": 0,

    // Load Modules
    "include": ["~/.config/waybar/modules.jsonc"],

    "hyprland/workspaces": {
        "format": "{name}",
        "all-outputs": false,
        "active-only": false,
        "show-special": false,
        "sort-by": "number",
        "on-click": "activate"
    },

    // Modules Left
    "modules-left": [
        "custom/cpu",
        "memory",
        "hyprland/workspaces"
    ],

    // Modules Center
    "modules-center": [
        "custom/notifications",
        "custom/lock_screen",
        "clock",
        "custom/power_btn",
        "custom/updates"
    ],
    
    // Modules Right
    "modules-right": [
        "wlr/taskbar",
        "pulseaudio",
        "pulseaudio#mic",
        "battery",
        "hyprland/language"
    ]
}
