configuration {
    show-icons: true;
    icon-theme: "Flat-Remix-Blue-Dark";
    drun-display-format: "{icon} {name}";
    display-drun: "󰍉";
}

* {
    font: "Roboto 12";
    background-color: transparent;
    // text-color: #FFFFFF;
    text-color: #1d1d1d;
    margin: 0px;
    padding: 0px;
    spacing: 0px;
}

window {
    location: north;
    y-offset: calc(50% - 176px);
    width: 480;
    border-radius: 24px;
    // background-color: #3b3b3bf2;
    background-color: #dbdbdbf2;
}

mainbox {
    padding: 12px;
}

inputbar {
    // background-color: #2A2A2A;
    background-color: rgba(223, 223, 223, 0.2);
    // border-color: #AB47BC;
    border-color: rgba(121, 121, 121, 0.2);
    border: 2px;
    border-radius: 20px;
    margin: 10px 10px 0 10px;
    padding: 8px 18px;
    spacing: 8px;
    children: [prompt, entry];
}

prompt {
    text-color: #969696;
}

entry {
    placeholder: "Search...";
    placeholder-color: #5E5E5E;
}

message {
    margin: 12px 0 0;
    border-radius: 16px;
    border-color: #3D3D3D80;
    background-color: #3D3D3D80;
}

textbox {
    padding: 8px 24px;
}

listview {
    background-color: transparent;
    margin: 12px 0 0;
    lines: 8;
    columns: 1;
    fixed-height: false;
    scrollbar: true;
}

element {
    margin: 5px 10px;
    padding: 8px 16px;
    spacing: 8px;
    border-radius: 18px;
}

element normal active {
    text-color: #616161F2;
}

element alternative active {
    text-color: #616161F2;
}

element selected normal, element selected active {
    // background-color: #AB47BC;
    background-color: rgba(15, 133, 201, 0.5);
}

element-icon {
    size: 1em;
    vertical-align: 0.5;
}

element-text {
    text-color: inherit;
}

scrollbar {
    padding: 10px 0;
    // handle-color: #AB47BC;
    handle-color: rgba(15, 133, 201, 0.5);
    handle-width: 8px;
}
